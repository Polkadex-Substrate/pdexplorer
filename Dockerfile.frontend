# Node 18 went EOL in April 2025 — bump to 22 LTS for security patches.
# Pinned to a specific minor for reproducible builds.
#
# Audit F-150: a minor tag still moves — Docker Hub re-publishes it on every
# base-image refresh, so this is not actually reproducible. Both FROM lines in
# this file (and the one in Dockerfile.backend) should carry a digest:
#     docker inspect --format='{{index .RepoDigests 0}}' node:22.11-alpine
#     docker inspect --format='{{index .RepoDigests 0}}' nginxinc/nginx-unprivileged:1.27-alpine
# then write `image@sha256:…`. Resolve them on a host with registry access.
FROM node:22.11-alpine AS build

WORKDIR /app
# Audit F-149: the lockfile was copied but then IGNORED — `npm install`
# re-resolves ranges, so the lock gave no reproducibility. `npm ci` installs
# it verbatim (and fails the build if lock and package.json disagree, which
# is the correct failure mode for a wallet's supply chain).
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .

# Build provenance. deploy.sh passes the git SHA of the tree it built from (with
# a `-dirty` suffix when the working tree had uncommitted changes). Emitting it
# as a static file means you can ask the RUNNING site what it is built from:
#     curl https://explorer.polkadex.ee/version.json
# and compare against `git rev-parse --short=12 HEAD`. Several outages today
# were "the fix isn't deployed" wearing the costume of "the fix doesn't work".
ARG GIT_SHA=unknown
ARG BUILD_TIME=unknown
RUN npm run build \
 && printf '{"component":"frontend","gitSha":"%s","builtAt":"%s"}\n' "$GIT_SHA" "$BUILD_TIME" > /app/dist/version.json

# Audit F-040 (SECURITY_AUDIT.md H-1, frontend half): run nginx as a NON-ROOT
# user. The stock nginx image runs the master process as uid 0, so a container
# break-in had root inside the container and could read privkey.pem outright.
# nginxinc/nginx-unprivileged is the official rootless variant (uid 101): pid
# and cache paths are pre-arranged for an unprivileged user, and because
# non-root can't bind <1024 it listens on 8080/8443 — nginx.conf and
# docker-compose port mappings match that.
#
# OPERATOR NOTE (first deploy after this change): the bind-mounted cert tree
# must be readable by uid/gid 101 — deploy.sh handles the chgrp/chmod
# idempotently. Pinned to the same 1.27 minor as before.
FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080 8443
CMD ["nginx", "-g", "daemon off;"]
