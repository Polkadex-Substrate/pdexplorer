# Node 18 went EOL in April 2025 — bump to 22 LTS for security patches.
# Pinned to a specific minor for reproducible builds.
FROM node:22.11-alpine AS build

WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install

COPY . .

# Build provenance. deploy.sh passes the git SHA of the tree it built from (with
# a `-dirty` suffix when the working tree had uncommitted changes). Emitting it
# as a static file means you can ask the RUNNING site what it is built from:
#     curl https://explorer.polkadex.ee/version.json
# and compare against `git rev-parse --short=12 HEAD`. Several outages today
# were "the fix isn't deployed" wearing the costume of "the fix doesn't work".
ARG GIT_SHA=unknown
ARG BUILD_TIME=unknown
RUN npm run build \
 && printf '{"component":"frontend","gitSha":"%s","builtAt":"%s"}\n' "$GIT_SHA" "$BUILD_TIME" > /app/dist/version.json

# Pin nginx to a specific minor too; the floating `nginx:alpine` tag breaks
# reproducible builds whenever upstream cuts a release.
FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
