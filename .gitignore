node_modules/
outputs/
dist/

# F-131: the shipped og-image lives in public/ (Vite copies public/ into
# dist). A second, different-bytes copy sat at the repo root doing nothing but
# inviting someone to edit the wrong one. It's untracked now; the sandbox that
# made this change couldn't delete the local file, so it's ignored instead —
# feel free to `rm og-image.png` at the repo root.
/og-image.png

# Third-party browser scripts copied out of node_modules by
# tools/vendor-assets.mjs so they ship from our own origin (audit F-029).
# Build artifacts, not source: the versions are pinned in package-lock.json
# and `npm run build` regenerates them via the `prebuild` hook. Never edit by
# hand — the next build overwrites it.
public/vendor/
*_cache.json
cache.json
data/
*.db
*.db-shm
*.db-wal
.env

# TLS material. certbot/conf/live/<domain>/privkey.pem is the PRIVATE KEY for
# the Cloudflare Origin certificate. It lives inside the deployment directory
# because docker-compose bind-mounts it into nginx, which means a stray
# `git add -A` run from the deploy directory would stage a production private
# key — this very nearly happened. Never track it.
certbot/

# A second, nested checkout that older versions of deploy.sh created by cloning
# into a RELATIVE "pdexscan" directory. Kept ignored so it can be retired
# without git ever trying to treat it as an embedded repository.
pdexscan/

.DS_Store
CLAUDE.md
polkadex-explorer-user-guide.pdf
