# =============================================================================
# Polkadex Explorer — environment configuration template
# =============================================================================
# Copy to .env (same directory as docker-compose.yml), edit, then:
#     docker compose up -d --build backend
#
# Every value below is OPTIONAL — server.js has sane defaults baked in. Set
# only what you want to override; leave the rest commented out.
#
# How values get picked up:
#   * Variables are read from .env by docker-compose and passed into the
#     backend container via `env_file: .env` (see docker-compose.yml).
#   * The DATA_PATH variable is ALSO interpolated by docker-compose itself
#     into the bind-mount path: ${DATA_PATH:-./data}:/app/data
#   * DOMAIN + LETSENCRYPT_EMAIL are read by init-letsencrypt.sh and by the
#     provision script too.
#
# To apply changes you must REBUILD the backend — docker-compose snapshots
# the container env at create time, so `restart` alone won't pick them up:
#     docker compose up -d --build backend
# =============================================================================

# ---- TLS / certbot ---------------------------------------------------------
DOMAIN=explorer.polkadex.ee
LETSENCRYPT_EMAIL=business@polkadex.ee
# Legacy alias accepted by init-letsencrypt.sh — same effect as DOMAIN.
# DOMAIN_NAME=explorer.polkadex.ee

# ---- Host bind mount for the SQLite index ----------------------------------
# Absolute path outside the repo is recommended; survives `docker compose down`
# and `docker volume prune`. Defaults to ./data (inside the repo).
DATA_PATH=/opt/pdexplorer/data

# ---- Host bind mount for the TLS certificates ------------------------------
# Where certbot stores certs and where the frontend nginx mounts them from.
# Leave unset and it resolves RELATIVE to whatever directory you run
# docker compose in — deploy from a second checkout and nginx gets an empty
# cert dir, refuses to start, and Cloudflare returns 521. Set it absolute.
CERTBOT_PATH=/opt/pdexplorer/certbot

# ---- Polkadex RPC (chain access) -------------------------------------------
# Comma-separated WS endpoints. First = primary, rest = automatic fallback.
# Default is the Cloudflare LB endpoint that fronts the origin pool
# (so.polkadex.ee, polkadex-rpc.faradaynodes.com, ...) so it auto-fails over
# between origins. When you run your own node, put it first.
POLKADEX_WS=wss://rpc.polkadex.ee
# Reconnect interval after a dropped socket (ms).
# POLKADEX_WS_RECONNECT_MS=2500

# ---- CORS allowlist for the API --------------------------------------------
# Comma-separated origins allowed to call /api/*. Same-origin (no Origin
# header) is always allowed regardless of this list.
ALLOWED_ORIGINS=https://explorer.polkadex.ee,http://localhost:3000

# ---- Diagnostics gate (audit F-038) -----------------------------------------
# /api/diag/* endpoints reveal operational internals (live RPC URL, pids,
# email provider status). With DIAG_TOKEN set, they require the token in a
# REQUEST HEADER — either of:
#     curl -H "Authorization: Bearer $DIAG_TOKEN" https://<host>/api/diag/rpc-health
#     curl -H "X-Diag-Token: $DIAG_TOKEN"         https://<host>/api/diag/rpc-health
# Left EMPTY, they answer only to un-proxied loopback callers (curl from the
# box itself).
#
# Audit F-193: `?token=` USED TO WORK AND NO LONGER DOES — it now answers 403.
# This template taught the query form, which put the shared secret into
# Cloudflare's request logs, the monitoring vendor's stored URL and alert
# emails, browser history, and the Referer of anything the page linked to.
# F-091 stopped OUR nginx logging the query string; it could not stop the edge,
# the vendor, or the browser. If you re-add `?token=` support, the leak comes
# back silently — everything keeps returning 200 for you while the token spreads.
#
# Uptime monitors that cannot send a header must point at the public
# /api/health instead — it returns { healthy } only, with no URLs, pids or
# email fields, and needs no credential.
DIAG_TOKEN=

# ---- Sitemap (drives /sitemap.xml + robots.txt) ----------------------------
# Absolute URL of the public site — used for every entry in the sitemap.
SITE_URL=https://explorer.polkadex.ee
# Per-section sizes (top-N from the SQLite index):
# SITEMAP_TOP_VALIDATORS=100
# SITEMAP_RECENT_BLOCKS=200
# SITEMAP_TOP_HOLDERS=100
# SITEMAP_CACHE_TTL_MS=300000

# ---- Price feed ------------------------------------------------------------
# Which live price sources to poll (csv). Default: coingecko.
# PRICE_PROVIDERS=coingecko
# Poll cadence (ms).
# PRICE_SYNC_INTERVAL_MS=600000

# CoinGecko (default source) — keyless public API that aggregates PDEX across
# its real markets. No key needed at the default 10-min cadence; set a free
# "demo" key for higher rate limits. COINGECKO_ID is the coin slug from
# coingecko.com/en/coins/<id>.
# COINGECKO_ID=polkadex
# COINGECKO_API_KEY=your-coingecko-demo-key

# CoinMarketCap (optional additional source) — add 'cmc' to PRICE_PROVIDERS and
# set a key from https://coinmarketcap.com/api/. Note PDEX may be delisted from
# CMC pending re-listing, so it can be stale.
# CMC_API_KEY=your-coinmarketcap-api-key
# CMC_SYMBOL=PDEX

# ---- Block / event indexer tuning ------------------------------------------
# Per-tick (every ~12s) the indexer attempts:
#   forward (BLOCKS_FORWARD_MAX)
# + backfill (BLOCKS_BACKFILL_CHUNK)
# + gap-fill (BLOCKS_GAP_FILL_CHUNK)
# blocks, in parallel batches of BLOCKS_FETCH_CONCURRENCY.
# Doubling any of these is generally safe — see the README "How to scale the
# indexer" section.
# BLOCKS_FORWARD_MAX=500
# BLOCKS_BACKFILL_CHUNK=500
# BLOCKS_GAP_FILL_CHUNK=100
# BLOCKS_FETCH_CONCURRENCY=8
# BLOCKS_MIN_BLOCK=1
# After ANY sync error, that sync's next ticks are skipped for this long
# (ms). Prevents load amplification when the RPC is timing out.
# SYNC_BACKOFF_MS=60000

# ---- Network-info / heavy queries ------------------------------------------
# Background pre-warm cadence for the home-page "Network Information" panel.
# NETWORK_INFO_REFRESH_MS=600000
# How long the cached totalUnlocking figure is fresh — the underlying full
# staking.ledger.entries() scan is the most expensive single RPC call.
# TOTAL_UNLOCKING_TTL_MS=1800000

# ---- Governance state-snapshot cadence (council / treasury / democracy) ----
# These three indexers poll current pallet state — they do NOT walk blocks.
# Governance state changes over hours/days, so ticking faster than every 5
# minutes just wastes RPC calls without surfacing meaningfully fresher data.
#
# The default is GOVERNANCE_REFRESH_MS=300000 (5 minutes); the per-pallet
# overrides below inherit that default unless explicitly set. Show all four at
# their DEFAULT values so this file isn't a footgun. Only uncomment and lower
# if you have a specific reason — most operators should never touch these.
# GOVERNANCE_REFRESH_MS=300000        # 5 minutes (default for all three)
# COUNCIL_REFRESH_MS=300000           # 5 minutes (inherits GOVERNANCE_REFRESH_MS)
# TREASURY_REFRESH_MS=300000
# DEMOCRACY_REFRESH_MS=300000

# ---- Staking-rewards crawler -----------------------------------------------
# Resumable block-walker for staking rewards. After backfill completes, the
# forward pass is just "scan the new blocks since last tick" — typically a
# no-op or a handful of blocks. Defaults are tuned for steady-state.
#
# For a FRESH INSTALL where you want backfill to finish faster, override:
#   STAKING_REWARDS_INTERVAL_MS=5000
#   STAKING_REWARDS_SCAN_BATCH=50
#   STAKING_REWARDS_BACKFILL_CHUNK=1000
# Combine the three for multiplicative speedup. Revert after backfill is done.
# STAKING_REWARDS_INTERVAL_MS=60000       # default 60s (steady-state)
# STAKING_REWARDS_SCAN_BATCH=8
# STAKING_REWARDS_BACKFILL_CHUNK=100
# STAKING_REWARDS_FORWARD_MAX=5000
# STAKING_REWARDS_MIN_BLOCK=1

# ---- Governance crawler (block-walking, separate from the state snapshots
#       above) — looks for council motions + treasury proposals in extrinsics --
# Same steady-state philosophy as staking-rewards. Override for fresh-install
# catch-up only.
# GOVERNANCE_INDEXER_INTERVAL_MS=90000    # default 90s (steady-state)
# GOV_BACKFILL_CHUNK=200
# GOV_FORWARD_MAX=5000
# GOV_MIN_BLOCK=1

# ---- Chain index (blocks + events) crawler ---------------------------------
# Cadence of the combined blocks + events crawler. Also controls the
# transaction-crawler partner that runs alongside it.
# CHAIN_INDEX_INTERVAL_MS=12000          # default 12s
# Gap-scan throttle. The gap-fill pass no longer runs a full-table scan every
# tick (that pinned a CPU/disk on large DBs). It scans a bounded recent window
# every CHAIN_GAP_SCAN_MS, a full-history scan every CHAIN_FULL_GAP_SCAN_MS, and
# immediately after any block-fetch failure. Defaults are fine for most setups.
# CHAIN_GAP_SCAN_MS=300000               # default 5 min (recent-window scan)
# CHAIN_FULL_GAP_SCAN_MS=3600000         # default 60 min (full-history safety scan)
# CHAIN_GAP_SCAN_WINDOW=5000             # default: scan the newest 5000 blocks
# CHAIN_FULL_SCAN_WINDOW=500000          # default: 500000 block heights per "full" gap sweep.
#                                        # Audit F-047: the full scan is a rolling WINDOW, not an
#                                        # unbounded LEAD over the whole blocks table. node:sqlite is
#                                        # synchronous, so an O(rows) window function on 12.8M rows
#                                        # blocks the event loop for seconds — and with WORKERS=1 the
#                                        # indexer IS the HTTP server, so that is a gateway timeout.
#                                        # The sweep covers the whole history across successive ticks.
#                                        # LOWER this if single-process ticks feel long; raising it
#                                        # trades responsiveness for finishing the sweep sooner.
# GAP_SCAN_SLOW_MS=500                   # default: 500ms. Tripwire on the gap sweep's duration.
#                                        # The sweep is synchronous, so its runtime IS a stall on the
#                                        # worker running it. Measured against a blocks table seeded to
#                                        # the production row count (12,941,836): a 5k recent window is
#                                        # 0.8ms, the 500k full-sweep slice is 85ms, and an UNBOUNDED
#                                        # scan of the whole table is 2,272ms — the last being what
#                                        # CHAIN_FULL_SCAN_WINDOW above exists to prevent.
#                                        # Exceeding this logs a warning naming the slice, so growth or
#                                        # a raised window is visible rather than silently becoming a
#                                        # multi-second stall again. Audit F-047.
# GAP_SCAN_SLICE=50000                   # default: 50000 heights per synchronous LEAD before the
#                                        # sweep yields the event loop. Audit F-047.
#                                        # node:sqlite is synchronous, so a LEAD window blocks the
#                                        # thread for its whole duration. Measured at the production
#                                        # row count (12,941,836): 500k heights = 85ms, 50k = ~8ms,
#                                        # and the whole table unsliced = 2,272ms.
#                                        # CHAIN_FULL_SCAN_WINDOW above still sets how much history a
#                                        # sweep covers per pass; this sets how much of it runs
#                                        # between yields. Coverage rate is unchanged — only the
#                                        # longest uninterrupted stall. LOWER it if the indexer feels
#                                        # jittery on slow storage; raising it trades responsiveness
#                                        # for slightly less loop overhead.
# HASH_ID_INLINE_MAX=25000               # default: 25000 rows. How much of the hash-keyed id rewrite
#                                        # may run on the BOOT path. Audit F-182.
#                                        # The rewrite is one BEGIN IMMEDIATE per table, so on a
#                                        # database with real legacy history it holds the SQLite write
#                                        # lock through startup. Boot now COUNTS first (read-only) and,
#                                        # above this ceiling, DEFERS: it logs the exact command, records
#                                        # the state at /api/diag/schema, and lets the indexer start.
#                                        # Deferring is not free — rows written before the F-021 change
#                                        # keep block-number ids, so a reorg at those heights is not
#                                        # detected. Run the migration in a window:
#                                        #   docker compose exec backend node --experimental-sqlite \
#                                        #       tools/migrate-hash-ids.mjs
#                                        # RAISE this to force the old inline behaviour.
# SQLITE_BUSY_TIMEOUT_HTTP_MS=30000      # default: 30s. How long an HTTP worker waits for the write
#                                        # lock before giving up. Audit F-089: this used to be 5s for
#                                        # every connection, tuned for the indexer's own checkpointing
#                                        # — so a login or a vote that arrived during an indexer bulk
#                                        # insert got SQLITE_BUSY and a 500 for no reason but timing.
#                                        # These writes are tiny and rare; waiting is correct.
# SQLITE_BUSY_TIMEOUT_INDEXER_MS=5000    # default: 5s. Deliberately SHORT: the indexer is the process
#                                        # that should notice contention rather than queue behind it,
#                                        # and F-181 retries its transient failures instead of exiting.

# ---- Analytics -------------------------------------------------------------
# Cadence for pre-warming the analytics KPI counts and daily time-series into
# KV (so /api/analytics/* is a cheap key-value read, not a live aggregate).
# ANALYTICS_COUNTS_REFRESH_MS=300000     # default 5 min

# ---- SQLite storage tuning -------------------------------------------------
# Per-connection page cache and per-connection mmap window. Bigger = more of
# the DB served from RAM instead of disk (a big win on any disk, essential on
# slow ones).
#
# Audit F-093. The old note here said "total RAM ≈ SQLITE_CACHE_MB × WORKERS"
# and then recommended SQLITE_CACHE_MB=512 with SQLITE_MMAP_MB=4096 for a
# 16 GB box. It counted the wrong knob: the mmap window is applied per
# connection too, and it was the far bigger of the two. The real total is
#
#   total ≈ (SQLITE_CACHE_MB + SQLITE_MMAP_MB) × WORKERS
#
# which makes that "16 GB" recipe 36 GB on an 8-worker host. Nothing errors at
# boot; the box just swaps and then OOM-kills a worker under load, which reads
# as an unrelated crash-loop days later.
#
# So DERIVE mmap from one RAM budget instead of picking both by feel. Give
# SQLite at most half of physical RAM (node heaps + the @polkadot/api metadata
# registry per worker need the rest):
#
#   per_worker_mb  = (RAM_MB / 2) / WORKERS
#   SQLITE_MMAP_MB = per_worker_mb - SQLITE_CACHE_MB
#
# WORKERS defaults to min(nproc, WORKERS_MAX) and WORKERS_MAX defaults to 8, so
# assume 8 on any 8+ core box unless you pin WORKERS below. RAISING WORKERS
# MEANS LOWERING THESE — the budget belongs to the machine, not to the worker.
#
#   4 GB  / 2 workers:  SQLITE_CACHE_MB=128  SQLITE_MMAP_MB=384
#   8 GB  / 4 workers:  SQLITE_CACHE_MB=128  SQLITE_MMAP_MB=896
#   16 GB / 8 workers:  SQLITE_CACHE_MB=256  SQLITE_MMAP_MB=768
#   32 GB / 8 workers:  SQLITE_CACHE_MB=512  SQLITE_MMAP_MB=1536
#
# (The mmap half is file-backed, so its resident cost is shared between workers
# and capped by the size of explorer.db — measured RSS usually lands under the
# formula. Budget with the formula anyway; it is the number that stays right
# once the DB outgrows RAM. Setting SQLITE_MMAP_MB well above the DB file size
# buys nothing.)
#
# The defaults below are deliberately safe for a small VPS: 128 + 1024 = 1152
# MB per worker, i.e. ~4.6 GB at the 4-worker mark. On a 2 GB box, lower them.
# SQLITE_CACHE_MB=128                    # default 128 MB page cache per worker
# SQLITE_MMAP_MB=1024                    # default 1 GB mmap window per worker

# ---- Transactions crawler --------------------------------------------------
# TX_CACHE_LIMIT=500
# TX_INITIAL_SCAN_BLOCKS=20000
# TX_OLDER_SCAN_BLOCKS=20000
# TX_SCAN_BATCH_SIZE=25

# ---- Validator history -----------------------------------------------------
# VALIDATOR_HISTORY_ERAS=30

# ---- Wallet dashboard ------------------------------------------------------
# UNCLAIMED_TTL_MS=1200000
# TREASURY_ACCOUNT=esoEt6uZ9vs23yW8aqTACLf1tViGpSLZKnhPXt5Nq7vQwHGew

# ---- HTTP server -----------------------------------------------------------
# PORT=3001

# ---- Cluster mode ----------------------------------------------------------
# Spread HTTP serving across CPU cores. Exactly one worker gets the indexer
# role and runs the chain sync loops.
#
# Audit F-156: when WORKERS > 1 the indexer worker does NOT serve HTTP
# (`const serveHttp = !indexer || WORKERS <= 1`). node:sqlite is synchronous, so
# a heavy backfill pass blocks that worker's event loop for its whole duration;
# keeping it out of the listen rotation is what stopped the 504s on data-heavy
# pages. Budget accordingly:
#
#   WORKERS=1  → 1 process, serving HTTP *and* indexing on one event loop
#   WORKERS=N  → N-1 HTTP workers + 1 dedicated indexer  (so N=4 gives 3)
#
# The primary refork()s crashed workers, transferring the indexer role to the
# replacement if the original indexer worker died. A DB-backed lease keeps
# "exactly one indexer" true across containers too, not just within one tree.
#
#   unset → min(cpu count, WORKERS_MAX); sensible default for a typical VPS
#   1     → no clustering, single process (best for local dev / debug logs)
#   N     → exactly N workers, clamped to ≤ WORKERS_MAX (N-1 of them serving HTTP)
# WORKERS=4
#
# Audit F-191: this block used to say "clamped to ≤16" while the code clamps to
# WORKERS_MAX, whose default is 8 (`Math.min(n, WORKERS_MAX)` in server.js).
# An operator who sized a 16-core box around that sentence got EIGHT workers,
# seven of them serving HTTP, and no message anywhere saying the request had
# been halved — the clamp is silent by design. Raise the ceiling explicitly if
# you actually want more; there is no reason to keep the docs number and the
# code number as two separate facts.
# WORKERS_MAX=8

# ---- Email alerts -----------------------------------------------------------
# Transactional email transport for governance/network email alerts. Leave
# unset (or =disabled) to run the explorer without email — subscribe form
# and dispatcher both no-op gracefully in that mode (good for dev/CI).
#
# Production: choose one of postmark | sendgrid. Both providers require:
#   - EMAIL_FROM verified at the provider (and matching DNS DKIM/SPF on the
#     domain, otherwise inbox providers will silently spam-bin your sends).
#   - The corresponding API token below.
# WARNING: .env.example is COMMITTED and this repository is PUBLIC. Never put a
# real credential on these lines — real values belong in .env, which is
# gitignored. A live Postmark token sat on the line below and was publicly
# readable on GitHub from 2026-06-19 to 2026-08-13 (flagged twice by
# GitGuardian) before anyone noticed.
# EMAIL_PROVIDER=postmark
# POSTMARK_TOKEN=your-postmark-server-token
# SENDGRID_API_KEY=your-sendgrid-api-key
# EMAIL_FROM=noreply@polkadex.ee
# EMAIL_FROM_NAME=Polkadex Explorer
# EMAIL_REPLY_TO=  # optional; leave blank for noreply
# Per-recipient cooldown to prevent accidental hammering from a buggy dispatch.
# EMAIL_MIN_INTERVAL_MS=10000
# Per-IP rate cap on /api/email/subscribe (signups/hour).
# EMAIL_SIGNUP_RATE_LIMIT_PER_HOUR=30
#
# Log subscriber addresses in plaintext instead of as a truncated SHA-256.
# Audit F-090: two log lines used to print the mailbox, and one of them fires on
# EVERY send while EMAIL_PROVIDER=disabled — which is the default — so a stock
# deployment wrote the address of everyone who signed up into journald, where it
# is retained and shipped wherever logs go. They are hashed now.
#
# Set this to 1 ONLY in local development, where seeing "would send to=me@…" is
# how you check the address is right. Never in production: the hash is a stable
# pseudonym for correlating repeat recipients in a log, which is all a log needs,
# and plaintext turns the log into a subscriber list.
# EMAIL_LOG_PLAINTEXT=0

# Hard ceiling on the caller-supplied page size for state_getKeysPaged via
# POST /api/rpc/call. Audit F-077: `count` was unbounded, so one request could
# make the node walk an entire storage prefix synchronously on the WebSocket
# every worker shares. The rate limiter caps requests per minute, not the cost
# of one request. The /chain-state browser pages at 100. Oversized requests are
# clamped, not rejected, and the response says so via `pageSizeClamped`.
# RPC_MAX_PAGE=100

# How long a scan_failures row that has exhausted its retry budget waits before
# its attempts are reset and the normal retry pass picks it up again (ms).
# The F-004 watermark is derived from the lowest OUTSTANDING failure and counts
# permanent ones on purpose — a block the node cannot serve is still a hole. But
# without this amnesty nothing could ever clear such a row, so ONE unreadable
# height froze the reported watermark and pinned the status at Degraded for the
# life of the database. Matches the in-memory gap amnesty (F-046) so the two
# cannot drift. Lower it only if you are actively repairing a known bad range.
# SCAN_AMNESTY_MS=21600000

# Ceiling on how much of `transactions` the one-time F-049 purge of pre-v3,
# extrinsic-hash-keyed rows may delete, as a fraction (0 < x <= 1).
#
# The purge identifies legacy rows by `event_derived != 1`, which is sound only
# because both row builders set it. If a future writer forgets, or a schema adds
# the column without backfilling, EVERY row looks legacy — so the purge refuses
# above this ceiling rather than emptying the table on an unattended boot. The
# refusal is printed, leaves the migration flag unset (so the next boot retries),
# and names the value that would let it through.
#
# Raise it only after inspecting a sample and confirming the rows really are
# pre-v3. A database with a long pre-v3 history can legitimately exceed 25%.
# TX_PURGE_MAX_FRACTION=0.25

# =============================================================================
# Audit F-191 — the knobs that existed only in the code
# =============================================================================
# Everything below is read by server.js / db.js / email.js / lib/ but was never
# named in this file. That is not a cosmetic gap: an env template is the only
# place an operator ever looks for "what can I change". Two of these cost real
# incidents —
#
#   * EVENTS_STRICT. An operator pointed at a PRUNED node has no way to know
#     the knob exists, so the indexer refuses every height whose events the
#     node will not serve and the index never finishes. The knob that makes a
#     pruned node usable was invisible.
#   * AUTH_RATE_LIMIT_PER_MIN. An office or mobile-carrier NAT presents one IP
#     for hundreds of people; the default 60/min locks the whole building out
#     of wallet sign-in, and the fix looks like a bug in the wallet.
#
# test/env-template.test.js asserts this file names EVERY `process.env.X` the
# runtime reads. If you add a knob and skip this file, that test fails — which
# is the point: the code is not allowed to grow a setting the operator cannot
# discover. Values shown are the CODE DEFAULTS; all lines are commented out, so
# uncommenting changes behaviour and deleting a line restores the default.

# ---- Indexer: events, gaps, and skipped-height recording --------------------
# EVENTS_STRICT: '1' (default) refuses to store a height whose events came back
# null instead of recording it as a clean scan with events_count=0 (audit
# F-006). Set to 0 ONLY on a pruned RPC that genuinely cannot serve old events
# — it restores the silent-zero-events behaviour, so the index will look
# finished when it is not.
# EVENTS_STRICT=1
# CHAIN_GAP_COUNT_LIMIT=500          # gap rows returned per scan (not the LEAD walk)
# SCAN_GAP_FILL_BATCH=20             # scan_failures retried per tick
# SCAN_MAX_ATTEMPTS=10               # after this many, a failure stops being retried
# SKIP_RECORD_MAX=2000               # heights recorded per forward-cap skip
# SKIP_DRAIN_PER_TICK=500                # default: 500 heights queued per tick from the skip tail.
#                                        # Audit F-010: SKIP_RECORD_MAX above caps how many skipped
#                                        # heights are written as scan_failures in one go. The REMAINDER
#                                        # used to be dropped — the log said it stayed "discoverable by
#                                        # the gap scan", which is true only for chain_index. governance
#                                        # and staking_rewards have no gap scan, so past the cap those
#                                        # heights were lost permanently while the badge said Synced.
#                                        # The remainder is now kept in kv (skip:tail:<indexer>) and
#                                        # drained this many heights per tick. RAISE to repair a large
#                                        # backlog sooner at the cost of a longer synchronous write.
# GAP_ATTEMPT_RESET_MS=21600000      # 6 h; forget per-gap attempt counts
# TX_BACKFILL_CHUNK=5000             # blocks per genesis-ward transaction pass
# TX_MIN_BLOCK=1                     # floor for the transaction backfill walk
# GOV_SCAN_BATCH=50                  # blocks per governance scan batch
# REORG_SWEEP_MAX=200                # max heights re-verified in one reorg sweep
# REORG_TAIL_MAX=64                  # unfinalized tail depth checked every tick
# VALIDATOR_SYNC_INTERVAL_MS=3600000 # 1 h between validator-set refreshes
# MIN_NOMINATOR_BOND_TTL_MS=3600000  # 1 h cache of the minNominatorBond constant
# POLKADEX_BLOCK_TIME_MS=12000       # nominal block time used for ETA maths

# ---- Chain RPC: watchdogs, caches, and rebuild policy -----------------------
# CHAIN_HEAD_STALE_MS=300000         # 5 min without a new head ⇒ head is "stale"
# CHAIN_HEAD_WATCHDOG_INTERVAL_MS=60000
# RPC_WATCHDOG_INTERVAL_MS=10000
# RPC_RESET_AFTER_MS=30000           # disconnected this long ⇒ rebuild the socket
# RPC_EXIT_AFTER_MS=1800000          # 30 min still down ⇒ exit, let the supervisor restart
# RPC_REBUILD_TIMEOUT_MS=30000
# STUCK_WS_REBUILD_COOLDOWN_MS=30000 # floor between two forced socket rebuilds
# RPC_HEALTH_MIN_PEERS=3             # below this, /api/diag/rpc-health says unhealthy
# RPC_HEALTH_TIMEOUT_MS=3000
# RPC_BLOCK_CACHE_SIZE=2000
# RPC_BLOCK_HASH_CACHE_SIZE=5000
# RPC_EVENTS_AT_CACHE_SIZE=2000
# DEBUG_RPC: set to any non-empty value for per-call RPC logging. Very loud;
# leave unset outside a debugging session.
# DEBUG_RPC=

# ---- Developer API (/api/state, /api/consts, /api/decode, /api/rpc/call) ----
# DEV_API_RATE_LIMIT_PER_MIN=60      # advertised cap; divided across workers (F-075)
# DEV_API_TIMEOUT_MS=20000
# DEV_API_MAX_ENTRIES=100            # page size cap for ?entries=1 storage-map walks
# DEV_RPC_MAX_INFLIGHT=12            # concurrent dev-API chain queries before shedding
# DEV_RPC_SLOT_MAX_MS=120000             # default: 120s. How long an in-flight budget slot may stay
#                                        # held after the caller has already timed out.
#                                        # Audit F-073: @polkadot/api 10.13.1 has no way to CANCEL an
#                                        # RPC call — its provider is send(method, params, isCacheable?,
#                                        # subscription?), with no AbortSignal — and the version is
#                                        # pinned because unpinning breaks wallet signing. So a call
#                                        # that times out keeps running on the node. The budget now
#                                        # holds its slot until the real call settles, which is what
#                                        # makes DEV_RPC_MAX_INFLIGHT bound work at the node rather
#                                        # than merely counting waiters. This is the leak valve: a
#                                        # promise that never settles at all would otherwise remove a
#                                        # slot permanently and 503 the developer endpoints until the
#                                        # process restarts. A forced release is logged.
# DECODE_MAX_EXTRINSICS=50           # per-call cap on /api/decode/:block

# ---- Auth + response cache --------------------------------------------------
# AUTH_RATE_LIMIT_PER_MIN: per-IP cap on /api/auth/challenge + /api/auth/verify
# (audit F-070). RAISE THIS if your users share an egress IP — one NATed office
# or carrier CGNAT is a single IP to this limiter.
# AUTH_RATE_LIMIT_PER_MIN=60
# RESPONSE_CACHE_MAX_BYTES=524288    # 512 KiB; larger responses are not cached

# ---- Email dispatcher timing ------------------------------------------------
# EMAIL_EVENT_MAX_AGE_MS=259200000   # 3 days; older events are never mailed
# EMAIL_EVENT_BATCH_MAX=10           # events per dispatch pass
# NETWORK_EMAIL_CHECK_MS=120000      # 2 min between network-alert evaluations

# ---- Cluster internals ------------------------------------------------------
# INDEXER_LEASE_TTL_MS=90000         # DB-backed "exactly one indexer" lease
# INDEXER_LEASE_RENEW_MS=30000
# REFORK_MAX_MS=30000                # backoff ceiling when reforking crashed workers
# SCHEMA_WAIT_MS=20000               # how long an HTTP worker waits for the migrator
#                                    # before applying the DDL itself (db.js)
# INDEXER_ROLE is set BY THE PRIMARY on each forked worker ('on' | 'off'), not
# by you. Setting it in .env does nothing useful in clustered mode and, in
# single-process mode, 'off' silently disables all chain indexing.
# INDEXER_ROLE=

# ---- SubQuery lag probe (/api/diag/subquery-lag) ----------------------------
# SUBQUERY_ENDPOINT=https://indexer.polkadex.ee/
# SUBQUERY_TIMEOUT_MS=1500
# SUBQUERY_MAX_LAG_BLOCKS=200

# ---- Read by tools/, not by the server --------------------------------------
# DATA_DIR is NOT a server knob (audit F-099: server.js derives its data
# directory from process.cwd(), and DATA_PATH is the compose-side host mount).
# It is honoured only by the standalone scripts under tools/ and by the one-off
# migration helpers, which run outside the container:
#   tools/index-health.mjs, tools/migrate-hash-ids.mjs
# DATA_DIR=./data
# GAP_LIMIT=40                       # tools/index-health.mjs: gap rows to print
# TX_BACKFILL_DB_PATH=               # backfill-transactions-from-events.mjs
# PRICE_BACKFILL_DB_PATH=            # price-history backfill helper
# INDEX_MIGRATION_DB_PATH=           # migrate-add-indexes.mjs

# ---- Set by the build / the container runtime, never by you -----------------
# GIT_SHA and BUILD_TIME are Docker build args stamped into the image by
# deploy.sh / provision-ubuntu.sh and surfaced on /api/version. Putting them in
# .env does not change the image; it just makes /api/version lie about which
# code is running, which is the exact question that endpoint exists to answer.
# GIT_SHA=
# BUILD_TIME=
# HOSTNAME is supplied by Docker and only used to label the indexer lease owner.
# HOSTNAME=
