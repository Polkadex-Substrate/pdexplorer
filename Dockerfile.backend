# Node 22+ is required for the built-in node:sqlite module.
# Pinned to a specific minor for reproducible builds.
#
# Audit F-150: a MINOR tag is not a pin. Docker Hub re-publishes `22.11-alpine`
# whenever the base Alpine or the Node build changes, so two builds months apart
# can ship different bytes with an identical git diff. Only a digest is
# immutable. Resolve and record one with:
#     docker pull node:22.11-alpine
#     docker inspect --format='{{index .RepoDigests 0}}' node:22.11-alpine
# then change this line to `FROM node:22.11-alpine@sha256:…`. Do it from a host
# with registry access and commit the digest — do not guess it.
FROM node:22.11-alpine

WORKDIR /app

# Install deps, then transfer ownership to the unprivileged `node` user that
# ships with the image (uid 1000). Running as a non-root user inside the
# container means a future RCE doesn't immediately have root inside the
# container — and a container escape lands as uid 1000 on the host, not root.
# Audit F-031/F-102: copy the LOCKFILE and use `npm ci`, not `npm install`.
# npm install against package.json alone re-resolves every range at build
# time, so two image builds months apart can ship different dependency trees
# with zero git diff — exactly how the wrong @polkadot/api got in. npm ci
# installs the lockfile verbatim and fails loudly if it disagrees with
# package.json.
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund && chown -R node:node /app

COPY --chown=node:node server.js db.js email.js backfill-transactions-from-events.mjs migrate-add-indexes.mjs ./
# lib/ is REQUIRED at runtime — server.js imports ./lib/gov-status.js. This
# COPY list is explicit (not `COPY . .`), so any new relative import must be
# added here or the container dies at startup with ERR_MODULE_NOT_FOUND and
# every /api/* route goes dark while the SPA still loads from nginx — the
# failure looks like "the API is broken", not "a file is missing". That cost
# two deploys on 2026-08-22; test/dockerfile-copy.test.js now asserts this
# list covers every relative import in server.js.
#
# Nothing else is added here on purpose: a COPY of a path that isn't in the
# repo FAILS THE BUILD, so each extra line is another way to break a deploy.
# Operator scripts under tools/ are deliberately NOT copied — run them with
#     docker compose exec -T backend node --experimental-sqlite - < tools/<script>
COPY --chown=node:node lib ./lib

# Build provenance, surfaced by GET /api/version. Declared AFTER npm install so
# a new SHA doesn't invalidate the dependency layer on every deploy.
ARG GIT_SHA=unknown
ARG BUILD_TIME=unknown
ENV GIT_SHA=$GIT_SHA
ENV BUILD_TIME=$BUILD_TIME

USER node

# Expose backend API port
EXPOSE 3001

# Start the server (node:sqlite needs the --experimental-sqlite flag on Node 22)
CMD ["node", "--experimental-sqlite", "server.js"]
