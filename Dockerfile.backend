# Node 22+ is required for the built-in node:sqlite module.
# Pinned to a specific minor for reproducible builds.
FROM node:22.11-alpine

WORKDIR /app

# Install deps, then transfer ownership to the unprivileged `node` user that
# ships with the image (uid 1000). Running as a non-root user inside the
# container means a future RCE doesn't immediately have root inside the
# container — and a container escape lands as uid 1000 on the host, not root.
# Audit F-031/F-102: copy the LOCKFILE and use `npm ci`, not `npm install`.
# npm install against package.json alone re-resolves every range at build
# time, so two image builds months apart can ship different dependency trees
# with zero git diff — exactly how the wrong @polkadot/api got in. npm ci
# installs the lockfile verbatim and fails loudly if it disagrees with
# package.json.
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund && chown -R node:node /app

COPY --chown=node:node server.js db.js email.js backfill-transactions-from-events.mjs migrate-add-indexes.mjs ./

# Build provenance, surfaced by GET /api/version. Declared AFTER npm install so
# a new SHA doesn't invalidate the dependency layer on every deploy.
ARG GIT_SHA=unknown
ARG BUILD_TIME=unknown
ENV GIT_SHA=$GIT_SHA
ENV BUILD_TIME=$BUILD_TIME

USER node

# Expose backend API port
EXPOSE 3001

# Start the server (node:sqlite needs the --experimental-sqlite flag on Node 22)
CMD ["node", "--experimental-sqlite", "server.js"]
