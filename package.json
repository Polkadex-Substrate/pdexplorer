{
  "name": "pdexplorer-clone",
  "version": "1.0.0",
  "description": "Polkadex Explorer",
  "type": "module",
  "scripts": {
    "dev": "npm run vendor && vite",
    "vendor": "node tools/vendor-assets.mjs",
    "prebuild": "npm run vendor",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node --experimental-sqlite server.js",
    "server": "node --experimental-sqlite server.js",
    "test": "node --experimental-sqlite --test \"test/*.test.js\""
  },
  "dependencies": {
    "@polkadot/api": "17.0.2",
    "@polkadot/keyring": "14.0.3",
    "@polkadot/types": "17.0.2",
    "@polkadot/util": "14.0.3",
    "@polkadot/util-crypto": "14.0.3",
    "cors": "2.8.6",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@fontsource/inter": "5.2.8",
    "boxicons": "2.1.4",
    "chart.js": "4.5.1",
    "qrcodejs": "1.0.0",
    "vite": "6.4.4"
  },
  "overrides": {
    "ws": "^8.21.3",
    "qs": "^6.16.0",
    "body-parser": "^2.3.0",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.23"
  }
}
